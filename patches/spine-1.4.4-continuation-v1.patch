@@ -0,0 +1,65 @@
+"""Version 1 production allocation pause/outcome contract.
+
+Environment paths are scoped to an immutable scheduler attempt. This helper
+publishes only after the driver finishes cleanup; the production controller
+also requires successful launcher exit and confirmed scheduler accounting.
+"""
+import hashlib
+import json
+import os
+from pathlib import Path
+import re
+import tempfile
+import time
+
+
+class Continuation:
+    def __init__(self, token, pause_file, outcome_file):
+        self.token = token
+        self.pause_file = Path(pause_file)
+        self.outcome_file = Path(outcome_file)
+
+    @classmethod
+    def from_environment(cls):
+        token = os.environ.get("SPINE_CONTINUATION_TOKEN")
+        if not token:
+            return None
+        return cls(token, os.environ["SPINE_PAUSE_FILE"], os.environ["SPINE_OUTCOME_FILE"])
+
+    @property
+    def pause_requested(self):
+        return self.pause_file.is_file()
+
+    def publish(self, state, reason, checkpoint):
+        if checkpoint is None:
+            raise RuntimeError("Continuation completed without a restart checkpoint")
+        checkpoint = Path(checkpoint).resolve()
+        match = re.fullmatch(r"snapshot-(\d+)\.ckpt", checkpoint.name)
+        if match is None:
+            raise ValueError("Continuation requires a numeric snapshot checkpoint")
+        digest = hashlib.sha256()
+        with checkpoint.open("rb") as stream:
+            for block in iter(lambda: stream.read(1024 * 1024), b""):
+                digest.update(block)
+        checksum = digest.hexdigest()
+        fields = Path(str(checkpoint) + ".sha256").read_text().split()
+        if len(fields) != 2 or fields[0] != checksum or fields[1].lstrip("*") != checkpoint.name:
+            raise ValueError("Checkpoint integrity sidecar is not committed")
+        result = dict(contract=1, token=self.token, state=state, reason=reason,
+                      checkpoint=str(checkpoint), sha256=checksum, iteration=int(match[1]),
+                      committed_at=time.time())
+        fd, temporary = tempfile.mkstemp(dir=self.outcome_file.parent, prefix="outcome.")
+        try:
+            with os.fdopen(fd, "w") as stream:
+                json.dump(result, stream)
+                stream.flush()
+                os.fsync(stream.fileno())
+            os.replace(temporary, self.outcome_file)
+            directory = os.open(self.outcome_file.parent, os.O_RDONLY)
+            try:
+                os.fsync(directory)
+            finally:
+                os.close(directory)
+        finally:
+            if os.path.exists(temporary):
+                os.unlink(temporary)
